
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] | Fundación</title>

    <script type="importmap"></script>

    <!-- Estilos generales -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Proyecto.styles.css" asp-append-version="true" />

    <link rel="stylesheet" href="~/css/navegacion.css" asp-append-version="true" />

    <!-- Estilos específicos de cada vista -->
    @await RenderSectionAsync("Styles", required: false)
</head>

<body>

    <partial name="_Navegacion" />

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    @if (IsSectionDefined("Footer"))
    {
        @await RenderSectionAsync("Footer")
    }
    else
    {
        <footer class="border-top footer text-muted">
            <div class="container">
                &copy; 2026 - Fundación
            </div>
        </footer>
    }

    <!-- JavaScript -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- Scripts específicos de cada vista -->
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
