@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Panel principal";
}

@section Styles {
    <link rel="stylesheet" href="~/css/panel.css" asp-append-version="true" />
}

<div class="panel">

    <aside class="panel-lateral">
        <div class="panel-lateral-marca">
            <span class="panel-marca-simbolo" aria-hidden="true"></span>
            <span>
                <strong>Fundación</strong>
                <small>Prevención del Suicidio</small>
            </span>
        </div>

        <nav class="panel-menu" aria-label="Módulos del sistema">
            <a class="panel-menu-item activo" asp-controller="Acceso" asp-action="Personal"
               aria-current="page">Inicio</a>

            <a class="panel-menu-item" asp-controller="Alertas" asp-action="Index">Alertas</a>

            <span class="panel-menu-item deshabilitado">
                Gestión de casos <small>Pronto</small>
            </span>
            <span class="panel-menu-item deshabilitado">
                Factores de riesgo <small>Pronto</small>
            </span>
            <span class="panel-menu-item deshabilitado">
                Seguimientos <small>Pronto</small>
            </span>
            <span class="panel-menu-item deshabilitado">
                Solicitudes <small>Pronto</small>
            </span>
            <span class="panel-menu-item deshabilitado">
                Comunicación <small>Pronto</small>
            </span>
            <span class="panel-menu-item deshabilitado">
                Estadísticas <small>Pronto</small>
            </span>
        </nav>

        <p class="panel-lateral-nota">
            Los apartados marcados como «Pronto» se habilitarán en las próximas etapas.
        </p>
    </aside>

    <section class="panel-contenido">
        <header class="panel-bienvenida">
            <p class="panel-saludo">Bienvenido/a</p>
            <h1>Hola, @User.Identity?.Name</h1>
            <p>
                Este es el panel del personal de la Fundación para la Prevención del
                Suicidio. Desde aquí podrá acceder a los módulos del sistema.
            </p>
        </header>

        <h2 class="panel-seccion-titulo">Módulos</h2>

        <div class="panel-tarjetas">

            <a class="panel-tarjeta" asp-controller="Alertas" asp-action="Index">
                <span class="panel-tarjeta-icono" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M18 8a6 6 0 1 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9" />
                        <path d="M13.7 21a2 2 0 0 1-3.4 0" />
                    </svg>
                </span>
                <span class="panel-tarjeta-titulo">Alertas</span>
                <span class="panel-tarjeta-texto">
                    Consulte y revise las alertas generadas por el análisis del chatbot.
                </span>
                <span class="panel-etiqueta">Disponible</span>
            </a>

            <div class="panel-tarjeta panel-tarjeta--pendiente">
                <span class="panel-tarjeta-icono" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
                    </svg>
                </span>
                <span class="panel-tarjeta-titulo">Gestión de casos</span>
                <span class="panel-tarjeta-texto">
                    Administre los casos abiertos y su seguimiento.
                </span>
                <span class="panel-etiqueta panel-etiqueta--pendiente">Próximamente</span>
            </div>

            <div class="panel-tarjeta panel-tarjeta--pendiente">
                <span class="panel-tarjeta-icono" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M10.3 4.3 2.6 17a2 2 0 0 0 1.7 3h15.4a2 2 0 0 0 1.7-3L13.7 4.3a2 2 0 0 0-3.4 0z" />
                        <path d="M12 9v4" />
                        <path d="M12 17h.01" />
                    </svg>
                </span>
                <span class="panel-tarjeta-titulo">Factores de riesgo</span>
                <span class="panel-tarjeta-texto">
                    Registre y consulte los factores de riesgo identificados.
                </span>
                <span class="panel-etiqueta panel-etiqueta--pendiente">Próximamente</span>
            </div>

            <div class="panel-tarjeta panel-tarjeta--pendiente">
                <span class="panel-tarjeta-icono" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M9 4h6v3H9z" />
                        <path d="M9 4H7a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2h-2" />
                        <path d="m9 14 2 2 4-4" />
                    </svg>
                </span>
                <span class="panel-tarjeta-titulo">Seguimientos</span>
                <span class="panel-tarjeta-texto">
                    Mantenga el registro de los seguimientos realizados.
                </span>
                <span class="panel-etiqueta panel-etiqueta--pendiente">Próximamente</span>
            </div>

            <div class="panel-tarjeta panel-tarjeta--pendiente">
                <span class="panel-tarjeta-icono" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 20s-7-4.4-7-9a4 4 0 0 1 7-2.6A4 4 0 0 1 19 11c0 4.6-7 9-7 9z" />
                    </svg>
                </span>
                <span class="panel-tarjeta-titulo">Solicitudes de acompañamiento</span>
                <span class="panel-tarjeta-texto">
                    Atienda las solicitudes de acompañamiento de los usuarios.
                </span>
                <span class="panel-etiqueta panel-etiqueta--pendiente">Próximamente</span>
            </div>

            <div class="panel-tarjeta panel-tarjeta--pendiente">
                <span class="panel-tarjeta-icono" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 11.5a8.4 8.4 0 0 1-8.4 8.4H8L3 23l1.5-5.2A8.4 8.4 0 0 1 12.6 3h.3a8.4 8.4 0 0 1 8.1 8.5z" />
                    </svg>
                </span>
                <span class="panel-tarjeta-titulo">Comunicación con profesionales</span>
                <span class="panel-tarjeta-texto">
                    Gestione la comunicación entre usuarios y profesionales.
                </span>
                <span class="panel-etiqueta panel-etiqueta--pendiente">Próximamente</span>
            </div>

            <div class="panel-tarjeta panel-tarjeta--pendiente">
                <span class="panel-tarjeta-icono" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M4 20V11" />
                        <path d="M10 20V4" />
                        <path d="M16 20v-6" />
                        <path d="M22 20H2" />
                    </svg>
                </span>
                <span class="panel-tarjeta-titulo">Estadísticas</span>
                <span class="panel-tarjeta-texto">
                    Consulte indicadores y resúmenes de la fundación.
                </span>
                <span class="panel-etiqueta panel-etiqueta--pendiente">Próximamente</span>
            </div>

        </div>
    </section>

</div>
