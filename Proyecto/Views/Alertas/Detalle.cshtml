@model Proyecto.ViewModels.AlertaDetalleViewModel
@{
    Layout = "_Layout";
    var alerta = Model.Alerta;
    var analisis = alerta.IdAnalisisNavigation;
    var mensaje = analisis.IdMensajeNavigation;
    var conversacion = mensaje.IdConversacionNavigation;

    ViewData["Title"] = $"Alerta {alerta.IdAlerta}";

    string ClaseEstado(string nombre) => nombre switch
    {
        "Pendiente de revisión" => "text-bg-warning",
        "En revisión" => "text-bg-info",
        "Cerrada" => "text-bg-success",
        _ => "text-bg-secondary"
    };
}
<p>
    <a asp-action="Index">&larr; Volver al listado de alertas</a>
</p>

<h1>Alerta @alerta.IdAlerta</h1>

<partial name="_Mensajes" />

<dl class="row">
    <dt class="col-sm-3">Estado</dt>
    <dd class="col-sm-9">
        <span class="badge @ClaseEstado(alerta.IdEstadoAlertaNavigation.Nombre)">
            @alerta.IdEstadoAlertaNavigation.Nombre
        </span>
    </dd>

    <dt class="col-sm-3">Generada</dt>
    <dd class="col-sm-9">@alerta.FechaGeneracion.ToString("dd/MM/yyyy HH:mm")</dd>

    <dt class="col-sm-3">Nivel de riesgo</dt>
    <dd class="col-sm-9">
        @analisis.IdNivelRiesgoNavigation.Nombre
        <span class="text-muted">(@analisis.IdNivelRiesgoNavigation.Descripcion)</span>
    </dd>

    <dt class="col-sm-3">Usuario</dt>
    <dd class="col-sm-9">@Model.UsuarioNombre</dd>

    <dt class="col-sm-3">Cédula del usuario</dt>
    <dd class="col-sm-9">@Model.UsuarioCedula</dd>

    <dt class="col-sm-3">Conversación</dt>
    <dd class="col-sm-9">
        #@conversacion.IdConversacion
        <span class="text-muted">(iniciada el @conversacion.FechaInicio.ToString("dd/MM/yyyy HH:mm"))</span>
    </dd>

    <dt class="col-sm-3">Análisis</dt>
    <dd class="col-sm-9">#@analisis.IdAnalisis del @analisis.FechaAnalisis.ToString("dd/MM/yyyy HH:mm")</dd>
</dl>

<h2 class="h4">Observaciones de la alerta</h2>
<p class="border rounded p-2 bg-light" style="white-space: pre-wrap;">@(string.IsNullOrWhiteSpace(alerta.Observaciones) ? "Sin observaciones." : alerta.Observaciones)</p>

<h2 class="h4">Resultado del análisis</h2>
<p class="border rounded p-2 bg-light" style="white-space: pre-wrap;">@analisis.Resultado</p>

<h2 class="h4">Mensaje que originó la alerta</h2>
<p class="border rounded p-2 bg-light" style="white-space: pre-wrap;">@mensaje.Contenido</p>

<h2 class="h4">Historial de revisiones</h2>
@if (Model.Revisiones.Count == 0)
{
    <p class="text-muted">La alerta todavía no tiene revisiones registradas.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-sm align-middle">
            <thead>
                <tr>
                    <th scope="col">Fecha</th>
                    <th scope="col">Revisada por</th>
                    <th scope="col">Estado</th>
                    <th scope="col">Observaciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var revision in Model.Revisiones)
                {
                    <tr>
                        <td>@revision.FechaRevision.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@revision.EmpleadoNombre (@revision.CedulaEmpleado)</td>
                        <td>
                            <span class="badge @ClaseEstado(revision.Estado)">
                                @revision.Estado
                            </span>
                        </td>
                        <td style="white-space: pre-wrap;">@revision.Observaciones</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<h2 class="h4">Registrar revisión</h2>
@if (Model.Destinos.Count == 0)
{
    <div class="alert alert-secondary" role="status">
        Esta alerta no admite más cambios de estado.
    </div>
}
else
{
    <form asp-action="CambiarEstado" asp-route-id="@alerta.IdAlerta" method="post" class="row g-3">
        <div class="col-md-4">
            <label class="form-label" for="idEstado">Nuevo estado</label>
            <select id="idEstado" name="idEstado" class="form-select" required>
                @foreach (var destino in Model.Destinos)
                {
                    <option value="@destino.IdEstadoAlerta">@destino.Nombre</option>
                }
            </select>
        </div>
        <div class="col-12">
            <label class="form-label" for="observaciones">Observaciones</label>
            <textarea id="observaciones" name="observaciones" class="form-control"
                      rows="3" maxlength="1000" required
                      placeholder="Describa el motivo del cambio de estado."></textarea>
            <div class="form-text">Mínimo 5 caracteres. Queda registrado en el historial.</div>
        </div>
        <div class="col-12">
            <button type="submit" class="btn btn-primary">Guardar revisión</button>
        </div>
    </form>
}
